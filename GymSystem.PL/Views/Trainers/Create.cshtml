@model CreateTrainerViewModel
@{
    ViewBag.Title = "Create Trainer";
}
<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color">Add New Trainer</h3>
    </header>

    <form method="post" asp-action="Create" enctype="multipart/form-data">

        <!-- Trainer Info -->
        <div class="section-header mb-3">
            <h5 class="text-primary fw-bold">Personal Information</h5>
            <hr class="mt-2">
        </div>
        <div class="row g-3">

            <div class="form-group">
                <div class="mt-2">
                    <img id="photoPreview" src="#" alt="Profile Photo" class="img-thumbnail" style="max-width:200px; display:none;"/>
                </div>
                <label asp-for="PhotoFile" class="control-label" >Profile Photo <span class="text-danger">*</span></label>
                <input asp-for="PhotoFile" id="photoInput" accept="image/*" class="form-control" type="file" required/>
                <span asp-validation-for="PhotoFile" class="text-danger"></span>
                <small class="text-muted form-text">Max Size: 5MB. Allowed Extensions: JPG, JPEG, PNG</small>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" type="text" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Gender" class="form-label"></label>
                <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select">
                    <option value="">-- Select Gender --</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

        </div>
        <div class="section-header mb-3 mt-4">
            <h5 class="text-primary fw-bold">Address Information</h5>
            <hr class="mt-2">
        </div>
        <div class="row g-3">

            <div class="col-12 col-md-6">
                <label asp-for="BuildingNumber" class="form-label"></label>
                <input asp-for="BuildingNumber" class="form-control" />
                <span asp-validation-for="BuildingNumber" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Street" class="form-label"></label>
                <input asp-for="Street" class="form-control" />
                <span asp-validation-for="Street" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
        </div>
        <!-- Professional Information -->
        <div class="section-header mb-3 mt-4">
            <h5 class="text-primary fw-bold">Professional Information</h5>
            <hr class="mt-2">
        </div>
        <div class="row g-3">

            <div class="col-12 col-md-6">
                <label asp-for="Specialities" class="form-label"></label>
                <select asp-for="Specialities" asp-items="Html.GetEnumSelectList<TrainingType>()" class="form-select">
                    <option value="">-- Select Specialist --</option>
                </select>
                <span asp-validation-for="Specialities" class="text-danger"></span>
            </div>
        </div>

        <footer class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-fill">Add</button>
        </footer>
    </form>

</div>
@section Scripts{
    <partial name="_AlertBoxScript" />
}

<script>
    // Preview photo before upload
    document.getElementById('photoInput').addEventListener('change', function (e) {
    var file = e.target.files[0];
    if (file) {
    var reader = new FileReader();
    reader.onload = function (e) {
    var preview = document.getElementById('photoPreview');
    preview.src = e.target.result;
    preview.style.display = 'block';
    }
    reader.readAsDataURL(file);
    }
    });
</script>